{
  "openapi": "3.1.0",
  "info": {
    "title": "Contrat Axion",
    "version": "0.0.0"
  },
  "paths": {
    "/api/compta/v1/societes/{s}/frais/lecture-ticket": {
      "post": {
        "operationId": "lireTicketFrais",
        "tags": [
          "lecture-par-post",
          "sans-effet",
          "acces:lecture"
        ],
        "parameters": [
          {
            "name": "s",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "pieceId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "depart": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "arrivee": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "pieceId"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Introuvable"
          }
        }
      }
    }
  }
}
