{
  "openapi": "3.1.0",
  "info": {
    "title": "Contrat Axion",
    "version": "0.0.0"
  },
  "paths": {
    "/pieces": {
      "post": {
        "operationId": "deposerPieces",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "fichiers": {
                    "minItems": 1,
                    "maxItems": 20,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "format": "binary",
                      "contentEncoding": "binary"
                    }
                  },
                  "canal": {
                    "type": "string",
                    "enum": [
                      "glisser",
                      "chat",
                      "selecteur",
                      "photo_mobile",
                      "email",
                      "plateforme_agreee",
                      "api",
                      "dossier_surveille",
                      "portail_fournisseur"
                    ]
                  }
                },
                "required": [
                  "fichiers",
                  "canal"
                ]
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/pieces/{id}/etat": {
      "get": {
        "operationId": "etatPiece",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Introuvable"
          }
        }
      }
    },
    "/pieces/{id}/relancer": {
      "post": {
        "operationId": "relancerPiece",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Introuvable"
          },
          "409": {
            "description": "Conflit de version"
          }
        }
      }
    },
    "/pieces/{id}/champs/{nom}": {
      "patch": {
        "operationId": "corrigerChamp",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "nom",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "valeur": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "pourquoi": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 500
                  }
                },
                "required": [
                  "valeur",
                  "pourquoi"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Introuvable"
          },
          "404": {
            "description": "Introuvable"
          },
          "409": {
            "description": "Conflit de version"
          }
        }
      }
    }
  }
}
