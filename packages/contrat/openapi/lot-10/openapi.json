{
  "openapi": "3.1.0",
  "info": {
    "title": "Contrat Axion",
    "version": "0.0.0"
  },
  "paths": {
    "/ventes/indicateurs": {
      "get": {
        "operationId": "lireIndicateurs",
        "parameters": [
          {
            "name": "mois",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            }
          },
          {
            "name": "avecPropositions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/ventes/series": {
      "get": {
        "operationId": "listerSeries",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    }
  }
}
