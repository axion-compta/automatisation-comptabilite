{
  "openapi": "3.1.0",
  "info": {
    "title": "Contrat Axion",
    "version": "0.0.0"
  },
  "paths": {
    "/ventes/indicateurs": {
      "get": {
        "operationId": "lireIndicateurs",
        "parameters": [
          {
            "name": "mois",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
            }
          },
          {
            "name": "avecPropositions",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ]
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/ventes/series": {
      "get": {
        "operationId": "listerSeries",
        "parameters": [],
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/clients/{code}": {
      "get": {
        "operationId": "lireClient",
        "parameters": [
          {
            "name": "code",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "404": {
            "description": "Introuvable"
          }
        }
      }
    },
    "/api/compta/v1/societes/{s}/ventes/{id}/corrections": {
      "post": {
        "operationId": "corrigerVente",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-personne",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "s",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "clientCode": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  },
                  "dateOperation": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  },
                  "natures": {
                    "minItems": 1,
                    "maxItems": 100,
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "ligne": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 9007199254740991
                        },
                        "nature": {
                          "type": "string",
                          "minLength": 1,
                          "maxLength": 50
                        }
                      },
                      "required": [
                        "ligne",
                        "nature"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "factureOrigineId": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 50
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Introuvable"
          },
          "404": {
            "description": "Introuvable"
          },
          "409": {
            "description": "Conflit de version"
          },
          "412": {
            "description": "Version périmée"
          }
        }
      }
    },
    "/api/compta/v1/societes/{s}/ventes/{id}/valider": {
      "post": {
        "operationId": "validerVente",
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          },
          {
            "name": "if-match",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "x-personne",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "s",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          },
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK"
          },
          "400": {
            "description": "Introuvable"
          },
          "404": {
            "description": "Introuvable"
          },
          "409": {
            "description": "Conflit de version"
          },
          "412": {
            "description": "Version périmée"
          }
        }
      }
    }
  }
}
