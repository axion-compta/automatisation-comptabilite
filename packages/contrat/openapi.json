    "/abonnement/demandes-palier": {
      "post": {
        "operationId": "demanderPalier",
        "tags": [
          "acces:compte"
        ],
        "parameters": [
          {
            "name": "Idempotency-Key",
            "in": "header",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 8,
              "maxLength": 128
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$schema": "https://json-schema.org/draft/2020-12/schema",
                "type": "object",
                "properties": {
                  "code_demande": {
                    "type": "string",
                    "minLength": 1
