                "required": [
                  "code_demande",
                  "accord"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Créé"
          },
          "404": {
            "description": "Introuvable"
          },
          "422": {
            "description": "Refusé"
          }
        }
